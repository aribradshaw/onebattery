<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup and device-to-device transfer rules.
     Settings (SharedPreferences: theme, design capacity, notification options) are backed up.
     The database (battery history, measurements and per-app usage/drain history) is never copied
     off the phone: it describes this phone's battery, and the usage-access disclosure promises it
     stays on the device. Keep in sync with backup_rules.xml (API 29-30). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
