<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Package visibility: only apps with a launcher icon (the ones that can be in the foreground),
         so DrainTracker can show their names. Other packages fall back to the package name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".OneBatteryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.OneBattery">

        <!-- Launched through one of the aliases below; ui/LauncherIcon.kt enables the one matching
             the selected theme so the home-screen icon follows it. Only System is on by default. -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias
            android:name=".LauncherFlygon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_flygon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_flygon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherOthello"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_othello"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_othello"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherSystem"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_system"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_night"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_night"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous battery current measurement for capacity tracking" />
        </service>

        <!-- POWER_CONNECTED/DISCONNECTED are not delivered to manifest receivers since API 26,
             so only boot and app-update restarts are declared here. -->
        <receiver
            android:name=".PowerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
